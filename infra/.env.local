# 로컬 개발 전용 환경변수. 로컬 테스트 값만 담고 있어 커밋한다(시크릿 아님).
# dev/prod 는 .env.example 을 복사한 infra/.env 를 쓴다(커밋 금지).
#
#   # DB 만 컨테이너로 띄우고 앱은 IDE/gradle 로 실행 (기본 로컬 개발 방식)
#   cd infra && docker compose --env-file .env.local up -d postgres
#   cd hamster-back && ./gradlew :hamster-api:bootRun
#
#   # 전체 스택을 컨테이너로
#   cd infra && docker compose --env-file .env.local up -d

SPRING_PROFILES_ACTIVE=local

# ─────────────────────────────────────────────────────────────
# PostgreSQL — 로컬 DB 계정의 단일 출처.
# postgres 컨테이너 초기화와 컨테이너 내부 hamster-back 의 접속 정보가
# 모두 이 값들에서 파생된다(docker-compose.yml 참고).
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=library
POSTGRES_USER=hamster
POSTGRES_PASSWORD=hamster
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────
# 앱을 호스트에서 직접 실행(bootRun)할 때 쓰는 접속 정보 — host 는 localhost.
# 컨테이너 안 hamster-back 은 이 값 대신 compose 가 주입하는 postgres:5432 를 쓴다.
#   set -a && source infra/.env.local && set +a
# ─────────────────────────────────────────────────────────────
SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5432/library
SPRING_R2DBC_USERNAME=hamster
SPRING_R2DBC_PASSWORD=hamster

SPRING_FLYWAY_JDBC_URL=jdbc:postgresql://localhost:5432/library
SPRING_FLYWAY_USER=hamster
SPRING_FLYWAY_PASSWORD=hamster
