# docker compose 변수 주입용. 실제 값으로 채워 infra/.env 로 복사(절대 커밋 금지).
#   cp infra/.env.example infra/.env  &&  vi infra/.env
#   cd infra && docker compose up -d
#
# [SECRET] 표시 변수는 비밀값 — 운영에서 반드시 교체하고 절대 레포에 커밋하지 말 것.

# 컨테이너 레지스트리 / 이미지 태그 (image_build_push.sh 로 빌드·푸시한 이미지 좌표)
REGISTRY=localhost
TAG=latest

# 프론트(nginx) 호스트 노출 포트 (호스트:3000 → 컨테이너:80)
FRONT_PORT=3000

# 프로필: local(개발자 PC) | dev(개발 배포) | prod(운영)
#   - dev  : mock idp + http + 비보안 쿠키
#   - prod : sso idp + https 보안 쿠키, 모든 비밀 env 필수
SPRING_PROFILES_ACTIVE=dev

# ─────────────────────────────────────────────────────────────
# PostgreSQL (DB명 library, public 스키마). compose 의 postgres 서비스 초기화에 사용.
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=library
POSTGRES_USER=hamster
POSTGRES_PASSWORD=hamster                # [SECRET]

# ─────────────────────────────────────────────────────────────
# 백엔드 DB 접속 — 런타임은 R2DBC(reactive), 마이그레이션은 Flyway(JDBC) 로 분리.
# host 는 compose 내부 서비스명 'postgres' 사용.
# ─────────────────────────────────────────────────────────────
# 런타임 R2DBC
SPRING_R2DBC_URL=r2dbc:postgresql://postgres:5432/library
SPRING_R2DBC_USERNAME=hamster
SPRING_R2DBC_PASSWORD=hamster            # [SECRET]

# Flyway 마이그레이션 JDBC (R2DBC 와 별개의 커넥션)
SPRING_FLYWAY_JDBC_URL=jdbc:postgresql://postgres:5432/library
SPRING_FLYWAY_USER=hamster
SPRING_FLYWAY_PASSWORD=hamster           # [SECRET]

# ─────────────────────────────────────────────────────────────
# 인증
# ─────────────────────────────────────────────────────────────
# JWT 서명키는 32바이트 이상 랜덤 (예: openssl rand -base64 48)
AUTH_JWT_SECRET=                         # [SECRET] 필수
AUTH_IDP=mock

# 배포 도메인/주소 — 프론트(nginx)가 서비스되는 공개 URL.
#   프론트와 API 가 same-origin(nginx /api 프록시)이므로 동일 origin 한 개면 됨.
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 쿠키: HTTPS 운영이면 secure=true. (refresh-token 은 HttpOnly, path=/api/v0/auth)
AUTH_COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────
# 외부 SSO (AUTH_IDP=sso 일 때만 필요)
# ─────────────────────────────────────────────────────────────
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=                       # [SECRET]
SSO_REDIRECT_URI=http://localhost:3000/api/v0/auth/callback
